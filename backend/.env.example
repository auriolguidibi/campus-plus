# Copy to backend/.env (never commit it) or set these as real environment variables.

# --- Core (required when DJANGO_DEBUG=0) ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-with-python-c-"import secrets;print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=campus.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://campus.example.com
DJANGO_SSL_REDIRECT=1            # set 0 only if TLS is terminated and redirected by your proxy

# --- Database: SQLite by default; MySQL for production ---
# SQLITE_PATH=/var/lib/campus/db.sqlite3
DB_ENGINE=mysql                  # remove this block to stay on SQLite
DB_NAME=campusplus
DB_USER=campus
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Files ---
SERVE_MEDIA=0                    # 1 = Django serves /media/ itself (small sites); 0 = let nginx do it
# FRONTEND_DIST=/srv/campus/frontend/dist

# --- E-mail (password reset). Default prints to the console. ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Campus+ <no-reply@campus.example.com>

# --- Campus rules ---
CAMPUS_VERIFICATION_MODE=invite  # invite | admin | open
CAMPUS_INVITE_CODES=CODE-2026-A,CODE-2026-B
MARKET_REQUIRE_MODERATION=1
CONFESSIONS_PREMODERATION=1
STORY_DURATION_HOURS=24
LOG_LEVEL=INFO
